//@ mode: co2
//@ run-status: 7

#include <assert.h>
#include <stdlib.h>

[[noreturn]] void exit1() {
    exit(1);
}

[[__noreturn__]] void exit2() {
    exit(2);
}

void __attribute__((__noreturn__)) exit3() {
    exit(1);
}

void exit4() {
    exit(2);
}

fn main() {
    assert((0 ? exit1() : 5) == 5);
    assert((1 ? 3 : exit2()) == 3);
    int my_false = 0;
    assert((my_false ? exit3() : 5) == 5);
    assert((!my_false ? 3 : exit(5)) == 3);

    my_false ? exit4() : (void)0;

    assert(!(my_false ? exit(5) : NULL));
    assert(!(my_false ? exit(6) : 0));

    assert((0 ? 3 : exit(7)) == 12);
}
