//@ mode: co2
//@ compile-fail

use std::string::String;
use std::vec::Vec;

#include <stdbool.h>

fn f1() {
    String s = String::new();
    bool b = s == s;
        //   ^^^^^^ error: operator overloading is not supported
}

fn f2() {
    String s = String::new();
    s += s"foo";
//  ^^^^^^^^^^^ error: operator overloading is not supported
}

fn f3() {
    bool b = s"a" == s"b";
        //   ^^^^^^^^^^^^ error: operator overloading is not supported
    (void)b;
}

fn f4() {
    bool b = s"a".as_bytes() == s"a".as_bytes();
        //   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ error: operator overloading is not supported
    (void)b;
}

fn f5(s: *const str, t: *const str) {
    bool b = s == t;
        //   ^^^^^^ error: operator overloading is not supported
    (void)b;
}

fn f6(s: *const str) {
    u8 b = s.as_bytes()[0];
    //     ^^^^^^^^^^^^^^^ error: operator overloading is not supported
    (void)b;
}

fn f7() {
    Vec::<i32> v = Vec::<i32>::new();
    i32 x = v[0];
    //      ^^^^ error: operator overloading is not supported
    (void)x;
}

// The old structural unsized check missed tuple/array DST tails, treating
// `*(i32, str)` as thin. The solver knows `(i32, str): Sized` is false, so
// comparing such fat pointers is rejected like `*const str` above.
fn f8(p: *const (i32, str), q: *const (i32, str)) {
    bool b = p == q;
        //   ^^^^^^ error: operator overloading is not supported
    (void)b;
}

// Pointer arithmetic on a fat pointer needs `Index`; `*(i32, str)` is fat.
fn f9(p: *const (i32, str)) {
    auto q = p + 1;
    //       ^^^^^ error: operator overloading is not supported
    (void)q;
}

fn main() {
    f1();
    f2();
    f3();
    f4();
}
