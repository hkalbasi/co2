//@ mode: co2
//@ run-status: 0

use std::mem::transmute;
use std::mem::drop;
use std::vec::Vec;
use std::iter::Iterator;

#include <assert.h>

#[derive(Copy)]
pub struct F1St {
    x: u8,
    y: u8,
}

fn f1() {
    u16 a = 0xabcd;
    F1St b = transmute::<_, F1St>(a);
    assert(b.x == 0xcd);
    assert(b.y == 0xab);
}

fn f2() {
    // Method turbofish on an associated function actually takes effect
    // instead of being silently ignored.
    Vec::<i32> v = Vec::<i32>::new();
    v.push(1);
    v.push(2);
    Vec::<i32> w = Iterator::collect::<Vec::<i32>>(v.into_iter());
    assert(w.len() == 2);
    drop(w);
}

fn main() {
    f1();
    f2();
}
