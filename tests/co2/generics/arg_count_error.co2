//@ mode: co2
//@ compile-fail

use std::mem::{size_of, transmute};
use std::collections::HashMap;
use std::string::String;
use std::vec::Vec;
use std::iter::Iterator;

fn f1() {
    size_of::<i32, i64>();
  //^^^^^^^^^^^^^^^^^^^ Expected 1 generic argument, found 2
}

fn f2() {
    size_of::<i32, i64, *mut ()>();
  //^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Expected 1 generic argument, found 3
}

fn f3() {
    HashMap::<String, i32> v = HashMap::<String, i32>::new();
    v.get::<str, i32>("foo");
    //^^^ Expected 1 generic argument, found 2
}

fn f4() {
    transmute::<i32>(5);
  //^^^^^^^^^^^^^^^^ Expected 2 generic argument, found 1
}

fn f5(x: &str) {
    x.strip_circumfix::<&str, &str>(s"foo", s"bar");
    x.strip_circumfix(s"foo", s"bar");
    x.strip_circumfix::<>(s"foo", s"bar");
    x.strip_circumfix::<&str>(s"foo", s"bar");
    //^^^^^^^^^^^^^^^ Expected 2 generic argument, found 1
}

fn f6() {
    Vec::<i32> v = Vec::<i32>::new::<i32>();
  //               ^^^^^^^^^^^^^^^^^^^^^^ Expected 0 generic argument, found 1
    (void)v;
}

fn f7() {
    Vec::<i32> v = Vec::<i32>::new();
    Vec::<i32> w = Iterator::collect::<Vec::<i32>, i32>(v.into_iter());
  //               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Expected 1 generic argument, found 2
    (void)v;
    (void)w;
}


fn main() {}
