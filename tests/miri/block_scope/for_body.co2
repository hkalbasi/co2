//@ mode: co2
//@ miri-error

// A loop body is its own block, so a local declared inside it dies at the end
// of each iteration, not at function return.

fn main() {
    i32* p;
    for (i32 i = 0; i < 1; i += 1) {
        i32 y = 7;
        p = &y;
    }
    i32 escaped = *p;
                //^^ error:
    if (escaped != 7) {
        std::process::exit(1);
    }
}
