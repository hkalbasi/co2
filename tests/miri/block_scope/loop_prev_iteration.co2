//@ mode: co2
//@ miri-error

// Reusing a pointer to a loop-body local from the previous iteration is UB:
// that iteration's `y` is already dead when the next iteration runs.

fn main() {
    i32* p;
    for (i32 i = 0; i < 2; i += 1) {
        i32 y = 7;
        if (i == 1) {
            i32 read = *p;
                     //^^ error:
            if (read == 0) {
                std::process::exit(1);
            }
        }
        p = &y;
    }
}
