//@ mode: co2
//@ miri-error

// A `goto` out of a loop body and the blocks and `if` branch inside it ends
// their locals' lifetimes, even though the jump does not fall off the end of
// the block (C11 6.2.4p5).

fn main() {
    i32* p;
    for (i32 i = 0; i < 2; i += 1) {
        {
            i32 x = i;
            if (i == 1) {
                p = &x;
                goto escaped;
            }
        }
    }
escaped:
    i32 escaped = *p;
                //^^ error:
    if (escaped != 1) {
        std::process::exit(1);
    }
}
